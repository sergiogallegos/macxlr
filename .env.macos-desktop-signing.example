# Copy this file to .env.macos-desktop-signing and fill in the values before
# running ./scripts/build-signed-macos-desktop-app.sh

# Required for signing.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Option A: App Store Connect API credentials for notarization.
# APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# APPLE_API_KEY="ABC123XYZ"
# APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_ABC123XYZ.p8"

# Option B: Apple ID credentials for notarization.
# APPLE_ID="your-apple-id@example.com"
# APPLE_PASSWORD="app-specific-password"
# APPLE_TEAM_ID="TEAMID1234"

# Optional, only if your Apple account setup requires it.
# APPLE_PROVIDER_SHORT_NAME="YOURPROVIDER"
